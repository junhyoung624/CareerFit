# 이 파일을 복사해 .env.local 로 만들고 값을 채우세요. (.env.local 은 커밋 금지)
# NEXT_PUBLIC_ 이 붙은 값은 브라우저에 공개됩니다. 비밀값에는 절대 붙이지 마세요.

# ── Supabase ─────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 서버 전용 (RLS 우회 관리자 키)
SUPABASE_SECRET_KEY=

# ── LLM (Gemini, 서버 전용) ──────────────
GEMINI_API_KEY=
GEMINI_MODEL=

# ── 채용공고 소스 (서버 전용) ────────────
# mock | saramin | rocketpunch
JOB_SOURCE=mock
SARAMIN_API_KEY=
ROCKETPUNCH_API_KEY=

# ── 앱 ───────────────────────────────────
# 개발: http://localhost:3000
NEXT_PUBLIC_SITE_URL=
